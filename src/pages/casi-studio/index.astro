---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';

const crumbs = [{ label: 'Casi studio', href: '/casi-studio/' }];
---

<Base
  title="Casi studio: progetti Zendesk realizzati da CloudSherpa"
  description="I progetti di customer service realizzati da CloudSherpa con Zendesk: problema di partenza, intervento e risultati. Il caso Lottomatica Group."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Casi studio"
    title="Progetti reali, dal problema al risultato"
    lead="Come abbiamo riorganizzato il customer service dei nostri clienti con Zendesk."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="wrap">
      <article class="feature card--link" data-reveal>
        <div>
          <p class="eyebrow">Betting e gaming</p>
          <h2><a href="/casi-studio/lottomatica/">Lottomatica Group: un unico ambiente omnicanale e multi-brand</a></h2>
          <p>
            Da una gestione frammentata su più sistemi a flussi strutturati su tre livelli di supporto, con dashboard
            di monitoraggio e integrazioni con i sistemi aziendali.
          </p>
          <span class="more" aria-hidden="true">Leggi il caso studio →</span>
        </div>
        <ul>
          <li>Omnicanale</li>
          <li>Multi-brand</li>
          <li>3 livelli di supporto</li>
          <li>Integrazioni custom</li>
        </ul>
      </article>
      <p class="note" data-reveal>Altri casi studio sono in preparazione.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem 3rem;
    align-items: center;
    background: var(--ink);
    color: #c9d6dd;
    border-radius: calc(var(--radius) * 1.5);
    padding: clamp(1.75rem, 1rem + 4vw, 4rem);
  }
  .feature h2 {
    color: #fff;
  }
  .feature h2 a {
    color: inherit;
    text-decoration: none;
  }
  .feature h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .feature .eyebrow {
    color: #f3a9b6;
  }
  .more {
    font-weight: 650;
    color: #fff;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  li {
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 999px;
    padding: 0.4em 1em;
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .note {
    margin: 2rem 0 0;
    color: var(--text-soft);
  }
  @media (max-width: 56rem) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
</style>
