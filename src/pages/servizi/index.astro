---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { cta } from '../../data/site';

const crumbs = [{ label: 'Servizi', href: '/servizi/' }];
---

<Base
  title="Servizi Zendesk: implementazione, agenti AI, integrazioni"
  description="I servizi CloudSherpa: implementazione Zendesk, agenti AI, customer service omnicanale, integrazioni con i vostri sistemi, formazione e supporto."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Servizi"
    title="Tutto quello che serve per far funzionare Zendesk nella vostra azienda"
    lead="Dalla prima analisi al supporto dopo il lancio. Potete affidarci l’intero progetto oppure un singolo intervento su un ambiente già attivo."
    breadcrumbs={crumbs}
  >
    <div class="btn-row">
      <a class="btn btn--primary" href={cta.primary.href}>{cta.primary.label}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap list">
      {
        services.map((s, i) => (
          <article class="row card--link" data-reveal>
            <p class="n">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h2>
                <a href={`/servizi/${s.slug}/`}>{s.title}</a>
              </h2>
              <p>{s.short}</p>
            </div>
            <ul>
              {s.outcomes.slice(0, 3).map((o) => (
                <li>{o}</li>
              ))}
            </ul>
            <span class="go" aria-hidden="true">
              <Icon name={s.icon} />
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .list {
    display: grid;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1.3fr 1fr auto;
    gap: 1.5rem 2.5rem;
    align-items: start;
    padding-block: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--mist);
    line-height: 1.1;
    margin: 0;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row:hover h2 a {
    color: var(--red);
  }
  .row p:not(.n) {
    color: var(--text-soft);
    margin: 0;
    max-width: 34rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0.3rem 0 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.98rem;
    color: var(--slate);
    font-weight: 550;
  }
  li::before {
    content: '↗';
    margin-right: 0.5em;
    color: var(--red);
  }
  .go {
    color: var(--slate);
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--fog);
  }
  @media (max-width: 56rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .go {
      display: none;
    }
  }
</style>
