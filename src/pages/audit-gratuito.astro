---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AuditForm from '../components/AuditForm.astro';

const crumbs = [{ label: 'Audit gratuito', href: '/audit-gratuito/' }];
const steps = [
  { t: 'Ci raccontate come lavorate', d: 'Una call breve per capire canali, volumi e strumenti in uso.' },
  { t: 'Analizziamo il customer journey', d: 'Guardiamo come entra una richiesta, chi la gestisce e dove si perde tempo.' },
  { t: 'Ricevete le priorità', d: 'Vi diciamo dove state perdendo efficienza e da che cosa conviene partire.' },
];
---

<Base
  title="Audit gratuito del customer service"
  description="Richiedete un audit gratuito del vostro customer service: analizziamo il customer journey attuale e vi diciamo dove state perdendo efficienza. Senza impegno."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Audit gratuito"
    title="Scoprite dove il vostro customer service perde tempo"
    lead="Analizziamo gratuitamente il vostro customer journey attuale e vi diciamo dove state perdendo efficienza. È concreto, utile subito e non vi impegna all’acquisto."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="wrap layout">
      <div class="info">
        <h2>Come funziona</h2>
        <ol>
          {
            steps.map((s, i) => (
              <li>
                <span class="n">{i + 1}</span>
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <h2>Per chi è utile</h2>
        <ul class="checks">
          <li>Gestite le richieste da più canali non collegati tra loro</li>
          <li>Il team risponde spesso alle stesse domande</li>
          <li>Usate già Zendesk ma sospettate di sfruttarne solo una parte</li>
          <li>State valutando di introdurre un agente AI</li>
        </ul>
      </div>
      <div class="panel">
        <h2>Richiedete l’audit</h2>
        <p>Vi ricontattiamo per fissare la prima call.</p>
        <AuditForm kind="audit" />
      </div>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .info h2,
  .panel h2 {
    font-size: var(--step-2);
  }
  .info h2:not(:first-child) {
    margin-top: 3rem;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  ol li {
    display: flex;
    gap: 1rem;
  }
  .n {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
    font-weight: 700;
  }
  h3 {
    margin-bottom: 0.2rem;
  }
  ol p {
    margin: 0;
    color: var(--text-soft);
  }
  .panel {
    background: var(--snow);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.3);
    padding: clamp(1.4rem, 1rem + 2.5vw, 2.75rem);
    box-shadow: var(--shadow);
  }
  .panel > p {
    color: var(--text-soft);
    margin-bottom: 1.75rem;
  }
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
    }
    .panel {
      order: -1;
    }
  }
</style>
