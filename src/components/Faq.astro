---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <h3>{item.q}</h3>
          <span class="mark" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  h3 {
    margin: 0;
    font-size: var(--step-1);
  }
  summary:hover h3 {
    color: var(--red);
  }
  .mark {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    margin-top: -1px;
    background: var(--slate);
    transition: transform 0.2s;
  }
  .mark::after {
    transform: rotate(90deg);
  }
  details[open] .mark::after {
    transform: rotate(0);
  }
  p {
    margin: 0;
    padding: 0 3rem 1.6rem 0;
    color: var(--text-soft);
    max-width: 46rem;
  }
</style>
